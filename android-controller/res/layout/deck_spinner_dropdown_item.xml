<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="14dp"
    android:paddingStart="14dp"
    android:paddingRight="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/spinner_dropdown_selector">

    <!-- Ink Icon 1 -->
    <ImageView
        android:id="@+id/iv_dropdown_ink_one"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginRight="6dp"
        android:layout_marginEnd="6dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Ink 1" />

    <!-- Ink Icon 2 -->
    <ImageView
        android:id="@+id/iv_dropdown_ink_two"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Ink 2" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_dropdown_deck_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-black"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_dropdown_deck_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>

