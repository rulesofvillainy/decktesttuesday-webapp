{
  "name": "deck-test-tuesday-app",
  "version": "1.0.0",
  "private": true,
  "description": "Deck Test Tuesday (DTT) - Disney Lorcana Livestream Tracker & Community Deck Hub for Rules of Villainy",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "db:init": "node --env-file=.env.local scripts/init-db.mjs",
    "db:sync": "node --env-file=.env.local scripts/sync-local-to-db.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:rls": "node --env-file=.env.local scripts/enable-rls.mjs",
    "youtube:import": "node --dns-result-order=ipv4first --env-file=.env.local scripts/import-youtube.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "next": "^16.4.6",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
