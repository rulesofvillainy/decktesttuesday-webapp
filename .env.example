# =============================================================================
# Deck Test Tuesday (DTT) - Rules of Villainy Environment Configuration
# =============================================================================

# PostgreSQL Connection String (Neon / Supabase / Render Free Tier)
# Leave empty in local development to use the built-in seeded local JSON store,
# or provide your Neon/Supabase connection URL:
# DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""

# Shared Admin Password for Andy & Kirsten (/admin/login & /admin/controller)
ADMIN_PASSWORD="villainy"

# Optional secret salt for signing HTTP-only admin session cookies
SESSION_SECRET="dtt-rules-of-villainy-secret-key-2026"

# YouTube Data API v3 Key (Used by /api/cron/youtube-sync to auto-import streams & detect live status)
YOUTUBE_API_KEY=""

# Rules of Villainy YouTube Channel ID (or search query fallback)
YOUTUBE_CHANNEL_ID="UC_RulesOfVillainy"

# Optional Cron Secret for securing /api/cron/youtube-sync in production
CRON_SECRET=""

# Configurable website URL chip displayed at the bottom center of the OBS Overlay (/overlay)
OVERLAY_SITE_URL="DTT.Villainy.Ink"
